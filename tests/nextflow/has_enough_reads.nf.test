nextflow_process {

    name "Test Process has has_enough_reads"
    script "process/competitive_mapping.nf"
    process "has_enough_reads"

    test("Should return true if Json file has value Mycobacterium tuberculosis H37Rv complete genome and the the number of reads is bigger or equals to the threshold specified") {

        when {
            process{
                """
                input[0] = ["sample", file("$projectDir/test_data/check_read_count/enough_tb.json")]
                input[1] = 100000
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0
            assert process.out[0][0][0] == 'sample'
            assert process.out[0][0][1] == 'true'
        }
    }


    test("Should return false if Json file has value Mycobacterium tuberculosis H37Rv complete genome and the the number of reads is smaller than threshold specified") {

        when {
            process{
                """
                input[0] = ["sample", file("$projectDir/test_data/check_read_count/not_enough_tb.json")]
                input[1] = 100000
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0
            assert process.out[0][0][1] == 'false'
        }
    }


    test("Should return false if Json file does not have value Mycobacterium tuberculosis H37Rv complete genome") {

        when {
            process{
                """
                input[0] = ["sample", file("$projectDir/test_data/check_read_count/no_mb_value.json")]
                input[1] = 100000
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0
            assert process.out[0][0][1] == 'false'
        }
    }

    test("Should return false if Json file does not have genome_name key") {

        when {
            process{
                """
                input[0] = ["sample", file("$projectDir/test_data/check_read_count/no_genome_name_key.json")]
                input[1] = 100000
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0
            assert process.out[0][0][1] == 'false'
        }
    }
}
