nextflow_workflow {

    name "Test Workflow"
    script "main.nf"
    workflow "competitive_mapping"

    test("Illumina - Should succeed producing a competitive mapping json, error json file, and the path to the positive filtered files") {
        tag 'illumina'
        when {
            workflow {
                """
                input[0] = Channel.of(['sample_test', [file("$projectDir/test_data/TB_10k/TB_1.fastq.gz"), file("$projectDir/test_data/TB_10k/TB_2.fastq.gz")]])
                input[1] = file("$projectDir/data/manifest/manifest_20231001")
                input[2] = file("$projectDir/test_data/species_list_manifest_20240710.csv")
                input[3] = 'illumina'
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out.cm_report) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison_report.json")
            }

            with(workflow.out.cm_csv) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison.csv")
            }

            with(workflow.out.cm_tb_reads) {
                assert size() == 1
                assert get(0)[1][0].contains("reads_for_assembly_1.fastq.gz")
                assert get(0)[1][1].contains("reads_for_assembly_2.fastq.gz")
            }
        }
    }

    test("ONT - Should succeed producing a competitive mapping json, error json file, and the path to the positive filtered files") {
        tag 'ont'
        when {
            workflow {
                """
                input[0] = ['sample_test', file("$projectDir/test_data/TB_ont/ont_lineage4_10.fastq.gz")]
                input[1] = file("$projectDir/data/manifest/manifest_20231001")
                input[2] = file("$projectDir/test_data/species_list_manifest_20240710.csv")
                input[3] = 'ont'
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out.cm_report) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison_report.json")
            }

            with(workflow.out.cm_csv) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison.csv")
            }

            with(workflow.out.cm_tb_reads) {
                assert size() == 1
                assert get(0)[1].contains("reads_for_assembly.fastq.gz")
            }
        }
    }


    test("Should return enough reads false if sample is not TB") {
        when {
            params {
                illumina_threshold = 5000
            }

            workflow {
                """
                input[0] = Channel.of(['sample_test', [file("$projectDir/test_data/chloro_10k/chloro_1.fastq.gz"), file("$projectDir/test_data/chloro_10k/chloro_2.fastq.gz")]])
                input[1] = file("$projectDir/data/manifest/manifest_20231001")
                input[2] = file("$projectDir/test_data/species_list_manifest_20240710.csv")
                input[3] = 'illumina'
                """
            }

        }

        then {
            assert workflow.success
            assert workflow.out.cm_enough_reads[0][1] == 'false'
        }

    }

    test("Should return enough reads true if sample is TB") {

        when {
            params {
                illumina_threshold = 5000
            }

            workflow {
                """
                input[0] = Channel.of(['sample_test', [file("$projectDir/test_data/TB_10k/TB_1.fastq.gz"), file("$projectDir/test_data/TB_10k/TB_2.fastq.gz")]])
                input[1] = file("$projectDir/data/manifest/manifest_20231001")
                input[2] = file("$projectDir/test_data/species_list_manifest_20240710.csv")
                input[3] = 'illumina'
                """
            }

        }

        then {
             assert workflow.success
             assert workflow.out.cm_enough_reads[0][1] == 'true'
        }

    }

}
