nextflow_workflow {

    name "Test Workflow"
    script "main.nf"
    workflow "competitive_mapping"

    test("Should succeed producing a competitive mapping json, en error json file, and the path to the positive filtered files") {

        when {
            params {
                input_dir = "/mnt/volume_data/work_packages/data/clinic/"
                manifest = "/mnt/volume_data/work_packages/data/manifest/target_101_new.fasta"
            }

            workflow {
                """
                input[0]  = ['sample_test', file("/mnt/volume_data/work_packages/data/clinic/test_clinic_sample_1.fastq.gz"), file("/mnt/volume_data/work_packages/data/clinic/test_clinic_sample_2.fastq.gz")]
                input[1]  = file("/mnt/volume_data/work_packages/data/manifest/target_101_new.fasta")
                """
            }

        }

        then {
             assert workflow.success

             with(workflow.out.cm_report) {
                assert size() == 1
                assert get(0).contains("competitivemapping_report.json")
            }

            with(workflow.out.cm_error) {
                assert size() == 1
                assert get(0).contains("competitivemapping_error.json")
            }

            with(workflow.out.cm_sample_paths) {
                assert size() == 1
                assert get(0)[1].contains("h37rv_1.fastq.gz")
                assert get(0)[2].contains("h37rv_2.fastq.gz")
            }
        }

    }


    test("Should return enough reads false if sample is not TB") {

        when {
            params {
                input_dir = "/mnt/volume_data/work_packages/data/nmtb/1/"
                manifest = "/mnt/volume_data/work_packages/data/manifest/target_101_new.fasta"
            }

            workflow {
                """
                input[0] = ['sample_test', file("/mnt/volume_data/work_packages/data/nmtb/1/file_R1.fastq.gz"), file("/mnt/volume_data/work_packages/data/nmtb/1/file_R2.fastq.gz")]
                input[1]  = file("/mnt/volume_data/work_packages/data/manifest/target_101_new.fasta")
                """
            }

        }

        then {
            assert workflow.success
            assert workflow.out.cm_enough_reads[0] == 'false'
        }

    }

    test("Should return enough reads true if sample is TB") {

        when {
            params {
                input_dir = "/mnt/volume_data/work_packages/data/h37rv_tb/1/"
                manifest = "/mnt/volume_data/work_packages/data/manifest/target_101_new.fasta"
            }

            workflow {
                """
                input[0] = ['sample_test', file("/mnt/volume_data/work_packages/data/h37rv_tb/1/WTCHG_885333_73205296_1.fastq.gz"), file("/mnt/volume_data/work_packages/data/h37rv_tb/1/WTCHG_885333_73205296_2.fastq.gz")]
                input[1]  = file("/mnt/volume_data/work_packages/data/manifest/target_101_new.fasta")
                """
            }

        }

        then {
             assert workflow.success
             assert workflow.out.cm_enough_reads[0] == 'true'
        }

    }

}
