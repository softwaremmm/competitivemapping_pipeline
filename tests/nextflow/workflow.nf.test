nextflow_workflow {

    name "Test Workflow"
    script "main.nf"
    workflow "competitive_mapping"

    test("Should succeed producing a competitive mapping json, en error json file, and the path to the positive filtered files") {

        when {
            params {
                input_dir = "data/WTCHG_885333_73205296_1/"
                manifest = "data/manifest/manifest_20231001"
                species_list = "test_data/species_list_manifest_20231001.csv"
            }

            workflow {
                """
                input[0]  = ['sample_test', file("data/WTCHG_885333_73205296_1/WTCHG_885333_73205296_1.fastq.gz"), file("data/WTCHG_885333_73205296_1/WTCHG_885333_73205296_2.fastq.gz")]
                input[1]  = file("data/manifest/manifest_20231001")
                input[2] = file("test_data/species_list_manifest_20231001.csv")
                """
            }

        }

        then {
             assert workflow.success

             with(workflow.out.cm_report) {
                assert size() == 1
                assert get(0).contains("species_comparison_report.json")
            }

            with(workflow.out.cm_error) {
                assert size() == 1
                assert get(0).contains("species_comparison_error.json")
            }

            with(workflow.out.cm_sample_paths) {
                assert size() == 1
                assert get(0)[1].contains("reads_for_assembly_0_1.fastq.gz")
                assert get(0)[2].contains("reads_for_assembly_0_2.fastq.gz")
            }
        }

    }


    test("Should return enough reads false if sample is not TB") {

        when {
            params {
                input_dir = "data/abscessus/"
                manifest = "data/manifest/manifest_20231001"
                species_list = "test_data/species_list_manifest_20231001.csv"
            }

            workflow {
                """
                input[0] = ['sample_test', file("data/abscessus/file_R1.fastq.gz"), file("data/abscessus/file_R2.fastq.gz")]
                input[1]  = file("data/manifest/manifest_20231001")
                input[2] = file("test_data/species_list_manifest_20231001.csv")
                """
            }

        }

        then {
            assert workflow.success
            assert workflow.out.cm_enough_reads[0] == 'false'
        }

    }

    test("Should return enough reads true if sample is TB") {

        when {
            params {
                input_dir = "data/WTCHG_885333_73205296_1/"
                manifest = "data/manifest/manifest_20231001"
                species_list = "test_data/species_list_manifest_20231001.csv"
            }

            workflow {
                """
                input[0] = ['sample_test', file("data/WTCHG_885333_73205296_1/WTCHG_885333_73205296_1.fastq.gz"), file("data/WTCHG_885333_73205296_1/WTCHG_885333_73205296_2.fastq.gz")]
                input[1]  = file("data/manifest/manifest_20231001")
                input[2] = file("test_data/species_list_manifest_20231001.csv")
                """
            }

        }

        then {
             assert workflow.success
             assert workflow.out.cm_enough_reads[0] == 'true'
        }

    }

}
