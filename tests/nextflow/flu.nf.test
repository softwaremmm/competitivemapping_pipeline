nextflow_process {

    name "Test Process competitiveMapping with Flu"
    script "process/competitive_mapping.nf"
    process "competitiveMapping"


    test("Flu Illumina - Process should succeed when sample files and a manifest are provided") {
        tag "illumina"
        when {
            process{
                """
                input[0] = ['sample_test', [file("$projectDir/test_data/samples/illumina/flu/SRR29182379_1.fastq.gz"),
                                            file("$projectDir/test_data/samples/illumina/flu/SRR29182379_2.fastq.gz")]]
                input[1] = file("$projectDir/test_data/flu_manifest/manifest.fasta.gz")
                input[2] = file("$projectDir/test_data/flu_manifest/contigs.csv")
                input[3] = 'illumina'
                input[4] = ''
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0

            with(process.out.report_json) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison_report.json")
                assert path(get(0)[1]).json == path("$projectDir/test_data/samples/illumina/flu/species_comparison_report.json").json
            }

            with(process.out.report_csv) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison.csv")
            }

            with(process.out.ref_reads) {
                assert size() == 0
            }
        }
    }
}
