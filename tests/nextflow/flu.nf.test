nextflow_process {

    name "Test Process competitiveMapping"
    script "process/competitive_mapping.nf"
    process "competitiveMapping"


    test("Flu Illumina - Process should succeed when sample files and a manifest are provided") {
        tag "illumina"
        when {
            process{
                """
                input[0] = ['sample_test', [file("$projectDir/influenza/SRR29182379_1.fastq.gz"), file("$projectDir/test_data/influenza/SRR29182379_2.fastq.gz")]]
                input[1] = file("$projectDir/data/manifest/influenza/multifasta.fasta.gz")
                input[2] = file("$projectDir/test_data/flu_contigs_20250513.csv")
                input[3] = 'illumina'
                input[4] = ''
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0

            with(process.out.cm_report) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison_report.json")
            }

            with(process.out.cm_csv) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison.csv")
            }
        }
    }
}
