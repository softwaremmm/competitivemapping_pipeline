nextflow_process {

    name "Test Process competitiveMapping"
    script "process/competitive_mapping.nf"
    process "competitiveMapping"

    test("Process should succeed when sample files and a manifest are provided") {

        when {
            process{
                """
                input[0] = ['sample_test', file("data/WTCHG_885333_73205296_1/WTCHG_885333_73205296_1.fastq.gz"), file("data/WTCHG_885333_73205296_1/WTCHG_885333_73205296_2.fastq.gz")]
                input[1] = file("data/manifest/manifest_20231001")
                input[2] = file("test_data/species_list_manifest_20231001.csv")
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0


            with(process.out.cm_report) {
                assert size() == 1
                assert get(0).contains("species_comparison_report.json")
            }

            with(process.out.cm_error) {
                assert size() == 1
                assert get(0).contains("species_comparison_error.json")
            }

            with(process.out.cm_sample) {
                assert size() == 1
                assert get(0)[1].contains("h37rv_1.fastq.gz")
                assert get(0)[2].contains("h37rv_2.fastq.gz")
            }
        }
    }

}
