nextflow_process {

    name "Test Process competitiveMapping"
    script "process/competitive_mapping.nf"
    process "competitiveMapping"

    test("Illumina - Process should succeed when sample files and a manifest are provided") {
        tag "illumina"
        when {
            process{
                """
                input[0] = ['sample_test', [file("$projectDir/test_data/TB_10k/TB_1.fastq.gz"), file("$projectDir/test_data/TB_10k/TB_2.fastq.gz")]]
                input[1] = file("$projectDir/data/manifest/manifest_20231001")
                input[2] = file("$projectDir/test_data/species_list_manifest_20250324.csv")
                input[3] = 'illumina'
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0


            with(process.out.cm_report) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison_report.json")
                assert path(get(0)[1]).json == path("$projectDir/test_data/TB_10k/species_comparison_report.json").json
            }

            with(process.out.cm_csv) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison.csv")
            }

            with(process.out.cm_tb_reads) {
                assert size() == 1
                assert get(0)[1][0].contains("reads_for_assembly_1.fastq.gz")
                assert get(0)[1][1].contains("reads_for_assembly_2.fastq.gz")
            }
        }
    }

    test("Illumina - Process should succeed with NTM when sample files and a manifest are provided") {
        tag "illumina"
        when {
            process{
                """
                input[0] = Channel.of(['sample_test', [file("$projectDir/test_data/chloro_10k/chloro_1.fastq.gz"), file("$projectDir/test_data/chloro_10k/chloro_2.fastq.gz")]])
                input[1] = file("$projectDir/data/manifest/manifest_20231001")
                input[2] = file("$projectDir/test_data/species_list_manifest_20250324.csv")
                input[3] = 'illumina'
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0


            with(process.out.cm_report) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison_report.json")
                assert path(get(0)[1]).json == path("$projectDir/test_data/chloro_10k/species_comparison_report.json").json
            }

            with(process.out.cm_csv) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison.csv")
            }

            with(process.out.cm_tb_reads) {
                assert size() == 1
                assert get(0)[1][0].contains("reads_for_assembly_1.fastq.gz")
                assert get(0)[1][1].contains("reads_for_assembly_2.fastq.gz")
            }
        }
    }

    test("ONT - Process should succeed when sample files and a manifest are provided") {
        tag "ont"
        when {
            process{
                """
                input[0] = ['sample_test', file("$projectDir/test_data/TB_ont/ont_lineage4_10.fastq.gz")]
                input[1] = file("$projectDir/data/manifest/manifest_20231001")
                input[2] = file("$projectDir/test_data/species_list_manifest_20250324.csv")
                input[3] = 'ont'
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0


            with(process.out.cm_report) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison_report.json")
                assert path(get(0)[1]).json == path("$projectDir/test_data/TB_ont/species_comparison_report.json").json
            }

            with(process.out.cm_csv) {
                assert size() == 1
                assert get(0)[1].contains("species_comparison.csv")
            }

            with(process.out.cm_tb_reads) {
                assert size() == 1
                assert get(0)[1].contains("reads_for_assembly.fastq.gz")
            }
        }
    }

}
