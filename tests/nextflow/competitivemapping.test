nextflow_process {

    name "Test Process competitiveMapping"
    script "process/competitive_mapping.nf"
    process "competitiveMapping"

    test("Process should success with path channel with sample files and a manifest has been provided") {

        when {
            process{
                """
                input[0] = ['sample_test', file("tests/samples/local/test_clinic_sample_1.fastq.gz"), file("tests/samples/local/test_clinic_sample_2.fastq.gz")]
                input[1] = file("tests/samples/local/target_101_new.fasta")
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0


            with(process.out.cm_report) {
                assert size() == 1
                assert get(0).contains("competitivemapping_report.json")
            }

            with(process.out.cm_sample) {
                assert size() == 1
                assert get(0)[1].contains("h37rv_1.fastq.gz")
                assert get(0)[2].contains("h37rv_2.fastq.gz")
            }
        }
    }

}
