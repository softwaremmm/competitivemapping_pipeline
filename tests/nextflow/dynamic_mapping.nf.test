nextflow_process {

    name "Test Process dynamic tie_break"
    script "process/competitive_mapping.nf"
    process "dynamic_mapping"

    test("Illumina - Should succeed") {
        tag "illumina"
        when {
            process{
                """
                input[0] = Channel.of(['sample_test',
                            [file("$projectDir/test_data/samples/illumina/viral_mix/reads_1.fastq.gz"),
                             file("$projectDir/test_data/samples/illumina/viral_mix/reads_2.fastq.gz")],
                            file("$projectDir/test_data/samples/illumina/viral_mix/sylph_profile.tsv")])
                input[1] = [file("$projectDir/test_data/virus_refs_db/part_1/"),
                            file("$projectDir/test_data/virus_refs_db/part_2/")]
                input[2] = [file("$projectDir/test_data/virus_refs_db/part_1/taxonomy.tsv"),
                            file("$projectDir/test_data/virus_refs_db/part_2/taxonomy.tsv")]
                input[3] = 'illumina'
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0


            with(process.out.report_csv) {
                assert size() == 1
                assert path(get(0)[1]).md5 == path("$projectDir/test_data/samples/illumina/viral_mix/species_comparison.csv").md5
            }

            with(process.out.report_json) {
                assert size() == 1
                assert path(get(0)[1]).md5 == path("$projectDir/test_data/samples/illumina/viral_mix/species_comparison_report.json").md5
            }
        }
    }

    test("ONT - Should succeed") {
        tag "ont"
        when {
            process{
                """
                input[0] = Channel.of(['sample_test',
                            [file("$projectDir/test_data/samples/ont/viral_mix/reads.fastq.gz")],
                            file("$projectDir/test_data/samples/ont/viral_mix/sylph_profile.tsv")])
                input[1] = [file("$projectDir/test_data/virus_refs_db/part_1/"),
                            file("$projectDir/test_data/virus_refs_db/part_2/")]
                input[2] = [file("$projectDir/test_data/virus_refs_db/part_1/taxonomy.tsv"),
                            file("$projectDir/test_data/virus_refs_db/part_2/taxonomy.tsv")]
                input[3] = 'ont'
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0


            with(process.out.report_csv) {
                assert size() == 1
                assert path(get(0)[1]).md5 == path("$projectDir/test_data/samples/ont/viral_mix/species_comparison.csv").md5
            }

            with(process.out.report_json) {
                assert size() == 1
                assert path(get(0)[1]).md5 == path("$projectDir/test_data/samples/ont/viral_mix/species_comparison_report.json").md5
            }
        }
    }


}
