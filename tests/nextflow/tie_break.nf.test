nextflow_process {

    name "Test Process tie_break"
    script "process/competitive_mapping.nf"
    process "tie_break"

    test("Illumina - Should succeed") {
        tag "illumina"
        when {
            process{
                """
                input[0] = Channel.of(['sample_test', [file("$projectDir/test_data/samples/illumina/TB/TB_1.fastq.gz"),
                                                       file("$projectDir/test_data/samples/illumina/TB/TB_2.fastq.gz")]])
                input[1] = file("$projectDir/test_data/myco_manifest/manifest.fasta.gz")
                input[2] = file("$projectDir/test_data/myco_manifest/contigs.csv")
                input[3] = 'illumina'
                input[4] = file("$projectDir/test_data/tie_break_params/params_illumina.yml")
                input[5] = 'M.tuberculosis'
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0


            with(process.out.report_csv) {
                assert size() == 1
                assert path(get(0)[1]).md5 == path("$projectDir/test_data/samples/illumina/TB/tie_break_summary.csv").md5
            }

            with(process.out.stats) {
                assert size() == 1
                assert path(get(0)[1]).yaml == path("$projectDir/test_data/samples/illumina/TB/tie_break_stats.yaml").yaml
            }

            with(process.out.ref_reads) {
                assert size() == 1
                assert get(0)[1][0].contains("reads_for_assembly_1.fastq.gz")
                assert get(0)[1][1].contains("reads_for_assembly_2.fastq.gz")
            }
        }
    }

    test("ONT - Process should succeed") {
        tag "ont"
        when {
            process{
                """
                input[0] = ['sample_test', file("$projectDir/test_data/samples/ont/TB/lin4_10.fastq.gz")]
                input[1] = file("$projectDir/test_data/myco_manifest/manifest.fasta.gz")
                input[2] = file("$projectDir/test_data/myco_manifest/contigs.csv")
                input[3] = 'ont'
                input[4] = file("$projectDir/test_data/tie_break_params/params_ont.yml")
                input[5] = 'M.tuberculosis'
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0


            with(process.out.report_csv) {
                assert size() == 1
                assert path(get(0)[1]).md5 == path("$projectDir/test_data/samples/ont/TB/tie_break_summary.csv").md5
            }

            with(process.out.stats) {
                assert size() == 1
                assert path(get(0)[1]).yaml == path("$projectDir/test_data/samples/ont/TB/tie_break_stats.yaml").yaml
            }

            with(process.out.ref_reads) {
                assert size() == 1
                assert get(0)[1].contains("reads_for_assembly.fastq.gz")
            }
        }
    }

}
