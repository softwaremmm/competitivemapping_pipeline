// The following variable, set by Kubernetes, must also exist to run the pipeline
// with other executors.
env.WORKSPACE = 'offline'

params {
    testing = ''
    test_container_cm = ''
    help = ''
    publish_dir = ''
    refs_for_fastqs = ''
    fixed_refs = ''
    container_prefix = 'lhr.ocir.io/lrbvkel2wjot'
}


profiles {
    standard {
        docker {
            enabled = true
            temp = 'auto'
        }
    }

    no_docker {
        docker {
            enabled = false
        }
    }

    local_docker {
        docker {
            enabled = true
        }
        // Automated testing will need to create container with this name
        params {
            test_container_cm = "test_container_cm"
            container_prefix = 'lhr.ocir.io/lrbvkel2wjot'
        }

        process {
            maxRetries = 2
            errorStrategy = {
                task.attempt <= task.maxRetries ? 'retry' : 'ignore'
            }
        }
    }

    testing {
        docker {
            enabled = true
        }
        // Automated testing will need to create container with this name
        params {
            test_container_cm = "test_container_cm"
            container_prefix = 'lhr.ocir.io/lrbvkel2wjot'
        }
        params.testing = "true"
    }

    kubernetes {
        params.container_prefix = 'lhr.ocir.io/lrbvkel2wjot'
        k8s {
            workDir = '/workspace'
            namespace = 'default'

            serviceAccount = 'nextflow-bot'
            computeResourceType = 'Job'
            storageClaimName = 'nextflow-fss-claim'
            storageMountPath = '/workspace'
            launchDir = '/workspace/runs'
            projectDir = '/workspace/project'
            pod = [
                [privileged: true],
                [secret: 'nextflow-api-key-secret', mountPath: '/etc/nextflow-api-key'],
                [imagePullSecret: 'ocirsecret'],
                [hostPath: '/buckets', mountPath: '/workspace/buckets'],
                [annotation: 'cluster-autoscaler.kubernetes.io/safe-to-evict', value: 'false'],
                [
                    affinity: [
                        podAffinity: [
                            requiredDuringSchedulingIgnoredDuringExecution: [
                                [
                                    labelSelector: [
                                        matchExpressions: [
                                            [key: 'mounter-ready', operator: 'In', values: ['true']]
                                        ]
                                    ],
                                    topologyKey: 'kubernetes.io/hostname',
                                ]
                            ]
                        ]
                    ]
                ],
            ]
            fetchNodeName = true
            maxErrorRetry = 4
        }
        docker.enabled = true
        process.executor = 'k8s'
    }
}
